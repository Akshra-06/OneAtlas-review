generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  clerkId       String         @unique
  email         String         @unique
  emailVerified Boolean        @default(false)
  name          String?
  avatarUrl     String?
  status        UserStatus     @default(ACTIVE)
  lastActiveAt  DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  memberships   OrgMember[]
  ownedOrgs     Organization[] @relation("OrgOwner")
  sessions      UserSession[]

  @@index([email])
  @@index([clerkId])
  @@map("users")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  clerkSession String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

model Organization {
  id                   String        @id @default(cuid())
  clerkOrgId           String?       @unique
  name                 String
  slug                 String        @unique
  logoUrl              String?
  plan                 OrgPlan       @default(FREE)
  status               OrgStatus     @default(ACTIVE)
  maxApps              Int           @default(3)
  maxWorkflows         Int           @default(5)
  maxMembers           Int           @default(5)
  maxStorageMb         Int           @default(500)
  aiCallsPerMonth      Int           @default(100)
  stripeCustomerId     String?       @unique
  stripeSubscriptionId String?       @unique
  planExpiresAt        DateTime?
  ownerId              String
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  apiKeys              ApiKey[]
  auditLogs            AuditLog[]
  integrations         Integration[]
  members              OrgMember[]
  owner                User          @relation("OrgOwner", fields: [ownerId], references: [id])
  projects             Project[]

  @@index([slug])
  @@index([ownerId])
  @@map("organizations")
}

model OrgMember {
  id         String       @id @default(cuid())
  orgId      String
  userId     String
  role       UserRole     @default(MEMBER)
  invitedAt  DateTime     @default(now())
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([orgId])
  @@index([userId])
  @@map("org_members")
}

model Project {
  id            String          @id @default(cuid())
  orgId         String
  name          String
  slug          String
  description   String?
  type          ProjectType     @default(CRUD_APP)
  status        ProjectStatus   @default(DRAFT)
  prompt        String
  metadata      Json            @default("{}")
  subdomain     String          @unique
  customDomain  String?         @unique
  generatedCode Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  auditLogs     AuditLog[]
  deployments   Deployment[]
  envVars       ProjectEnvVar[]
  org           Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  workflows     Workflow[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([subdomain])
  @@map("projects")
}

model ProjectEnvVar {
  id        String   @id @default(cuid())
  projectId String
  key       String
  value     String
  isSecret  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("project_env_vars")
}

model Deployment {
  id             String           @id @default(cuid())
  projectId      String
  version        Int
  status         DeploymentStatus @default(QUEUED)
  env            DeploymentEnv    @default(PRODUCTION)
  cfDeploymentId String?
  cfWorkerName   String?
  deployedUrl    String?
  buildLog       String?
  buildDuration  Int?
  errorMessage   String?
  codeSnapshot   Json?
  triggeredBy    String?
  deployedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  telemetry      DeploymentTelemetry?

  @@unique([projectId, version])
  @@index([projectId])
  @@index([status])
  @@map("deployments")
}

model Workflow {
  id             String         @id @default(cuid())
  projectId      String
  name           String
  description    String?
  status         WorkflowStatus @default(DRAFT)
  triggerType    TriggerType    @default(MANUAL)
  definition     Json           @default("{\"edges\": [], \"nodes\": []}")
  cronExpression String?
  timezone       String?        @default("UTC")
  webhookSecret  String?
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  totalRuns      Int            @default(0)
  successRuns    Int            @default(0)
  failedRuns     Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  runs           WorkflowRun[]
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("workflows")
}

model WorkflowRun {
  id           String            @id @default(cuid())
  workflowId   String
  orgId        String
  status       WorkflowRunStatus @default(PENDING)
  trace        Json              @default("[]")
  inputData    Json?
  outputData   Json?
  errorMessage String?
  duration     Int?
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime          @default(now())
  workflow     Workflow          @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([orgId])
  @@index([orgId, status])
  @@index([status])
  @@map("workflow_runs")
}

model Integration {
  id           String              @id @default(cuid())
  orgId        String
  provider     IntegrationProvider
  name         String
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?
  metadata     Json                @default("{}")
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  org          Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
  @@index([orgId])
  @@map("integrations")
}

model ApiKey {
  id         String       @id @default(cuid())
  orgId      String
  name       String
  keyHash    String       @unique
  prefix     String
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("api_keys")
}

model AuditLog {
  id        String       @id @default(cuid())
  orgId     String
  userId    String?
  projectId String?
  action    String
  metadata  Json         @default("{}")
  ipAddress String?
  userAgent String?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project?     @relation(fields: [projectId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])

  @@index([orgId])
  @@index([userId])
  @@index([createdAt])
  @@index([orgId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION

  @@map("user_status")
}

enum OrgPlan {
  FREE
  PRO
  ENTERPRISE

  @@map("org_plan")
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
  CANCELLED

  @@map("org_status")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
  DELETED

  @@map("project_status")
}

enum ProjectType {
  CRUD_APP
  DASHBOARD
  ADMIN_PANEL
  WORKFLOW_APP
  CUSTOM

  @@map("project_type")
}

enum DeploymentStatus {
  QUEUED
  BUILDING
  DEPLOYING
  LIVE
  FAILED
  ROLLED_BACK
  REPAIRING
  BUILD_RETRY
  PROCESS_CRASHED

  @@map("deployment_status")
}

enum DeploymentEnv {
  PREVIEW
  PRODUCTION

  @@map("deployment_env")
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED

  @@map("workflow_status")
}

enum WorkflowRunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  TIMED_OUT
  CANCELLED

  @@map("workflow_run_status")
}

enum TriggerType {
  MANUAL
  SCHEDULE
  WEBHOOK
  DATABASE_EVENT
  FORM_SUBMIT
  API_CALL

  @@map("trigger_type")
}

enum IntegrationProvider {
  SLACK
  GMAIL
  GOOGLE_SHEETS
  GOOGLE_DRIVE
  NOTION
  GITHUB
  JIRA
  STRIPE
  ZAPIER
  WEBHOOK
  CUSTOM

  @@map("integration_provider")
}

model DeploymentTelemetry {
  id                String     @id @default(cuid())
  deploymentId      String     @unique
  buildDurationMs   Int        @default(0)
  startupTimeMs     Int        @default(0)
  repairCount       Int        @default(0)
  previewUptimeSec  Int        @default(0)
  memoryUsageMb     Int        @default(0)
  crashCount        Int        @default(0)
  failureCategory   String?
  repairedErrors    Json?       // Details of errors detected & repaired
  createdAt         DateTime   @default(now())
  deployment        Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)

  @@map("deployment_telemetry")
}
